# holdings-mcp's settings. Only the first two are needed; the feeds are polled once their URLs are set.

# Required: the Zotero libraries to mirror ("users/<id>" or "groups/<id>", comma-separated), and an API key;
# read-only is enough. These are the libraries quote-mcp reads.
HOLDINGS_ZOTERO_LIBRARIES=users/827407,groups/61098
HOLDINGS_ZOTERO_API_KEY=

# The feeds, on the LAN: a base URL gets the feed's path (/api/holdings/books, /api/holdings/counts).
# Unset or off, a feed isn't polled.
# HOLDINGS_BOOKS_URL=http://corpus-mcp.localdomain:8000
# HOLDINGS_COUNTS_URL=http://quote-mcp.localdomain:8000

# The service. The server refreshes every HOLDINGS_REFRESH_SECONDS (0: only on POST /api/refresh).
# HOLDINGS_DB=data/holdings.db
# HOLDINGS_HOST=0.0.0.0
# HOLDINGS_PORT=8000
# HOLDINGS_REFRESH_SECONDS=120

# Optional, for `npm run deploy`: the deploy account's SSH password.
# AUTHORING_DEPLOY_PASSWORD=

# The Cloudflare Access team (also set in /etc/holdings-mcp/env on the host).
# ACCESS_TEAM_DOMAIN=https://your-team.cloudflareaccess.com
