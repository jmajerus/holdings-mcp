[Unit]
Description=holdings-mcp MCP server (Streamable HTTP), refreshing from Zotero and the feeds
After=network-online.target
Wants=network-online.target

[Service]
User=holdings
Group=holdings
EnvironmentFile=/etc/holdings-mcp/env
WorkingDirectory=/opt/holdings-mcp/current
ExecStart=/usr/bin/node /opt/holdings-mcp/current/dist/cli.js serve
Restart=on-failure
RestartSec=30
NoNewPrivileges=yes
ProtectSystem=strict
PrivateTmp=yes
ReadWritePaths=/var/lib/holdings-mcp

[Install]
WantedBy=multi-user.target
